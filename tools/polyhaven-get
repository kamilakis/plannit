#!/usr/bin/env python3
"""polyhaven-get — fetch Poly Haven (CC0) assets into a project's assets/ (17 Nov).

    polyhaven-get <project> model   <id> [res]   -> assets/models/<id>/<id>_<res>.gltf + .bin + textures/
    polyhaven-get <project> texture <id> [res]   -> assets/textures/<id>/<id>_{diff,nor_gl,rough}_<res>.jpg
res: 1k (default for models), 2k (default for textures). Files already there are skipped. Stdlib only.
The scene loads them with engine.blender.api prop() (models) and pbr_detail() (textures)."""
import json, os, sys, urllib.request
UA = {'User-Agent': 'plannit-render/1.0'}
def get(url): return urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=60).read()
def save(url, path):
    if os.path.exists(path) and os.path.getsize(path) > 0: return 0
    os.makedirs(os.path.dirname(path), exist_ok=True); b = get(url); open(path, 'wb').write(b); return len(b)
proj, kind, aid = sys.argv[1:4]
files = json.loads(get(f'https://api.polyhaven.com/files/{aid}'))
n = 0
if kind == 'model':
    res = sys.argv[4] if len(sys.argv) > 4 else '1k'
    g = files['gltf'][res]['gltf']; d = os.path.join(proj, 'assets', 'models', aid)
    n += save(g['url'], os.path.join(d, os.path.basename(g['url'])))
    for rel, f in g.get('include', {}).items(): n += save(f['url'], os.path.join(d, rel))
elif kind == 'texture':
    res = sys.argv[4] if len(sys.argv) > 4 else '2k'
    d = os.path.join(proj, 'assets', 'textures', aid)
    for k in ('Diffuse', 'nor_gl', 'Rough'):
        u = files[k][res]['jpg']['url']; n += save(u, os.path.join(d, os.path.basename(u)))
else: sys.exit('kind: model | texture')
print(f'{aid}: {n / 1e6:.1f} MB downloaded into {d}')
